  <dialog class="overlay" id="scaleModal" aria-labelledby="scaleModalTitle">
    <div class="modal">
      <h3 id="scaleModalTitle">Enter real distance in metres</h3>
      <p class="helper oz-source-style-11" id="scaleModalHelp">Example: 4.4</p>
      <div class="field oz-source-style-3">
        <label for="scaleDistanceInput">Known wall distance</label>
        <input id="scaleDistanceInput" type="number" min="0" step="0.01" placeholder="4.4">
      </div>
      <div class="action-row">
        <button class="button" id="saveScaleButton" type="button">Save scale</button>
        <button class="button-secondary" id="cancelScaleButton" type="button">Cancel</button>
      </div>
    </div>
  </dialog><noscript><p class="shell">Turn on JavaScript to measure your plan, or <a href="/contact/">send an enquiry without using the tool</a>.</p></noscript></body></html>
